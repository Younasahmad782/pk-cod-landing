# Copy this file to .env.local and fill in real values per client.
# Meta Pixel (browser-side). Get it from Meta Events Manager.
NEXT_PUBLIC_FB_PIXEL_ID=
# Meta Conversions API (server-side). Same Pixel ID + a token from
# Events Manager → Settings → Conversions API → Generate access token.
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
# Secret key for downloading orders: /api/order/export?key=THIS
ADMIN_EXPORT_KEY=change-me-in-env
